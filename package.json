  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "vite",
    "build": "bun run generate:sitemap && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "bun run build && vite preview",
